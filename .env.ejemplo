# =============================================================================
#  Scout Picks · credenciales del importador
#
#  COPIA ESTE ARCHIVO COMO  .env  (sin extensión) en esta misma carpeta
#  y pega tu clave después del signo igual, sin comillas y sin espacios.
#
#  .env está excluido por .gitignore: no se sube a ningún sitio.
#  No lo compartas ni lo pegues en un chat.
# =============================================================================

# API-Football -> https://dashboard.api-football.com/register (plan Free)
# 100 peticiones al día. Es lo que da estadísticas de cada jugador en cada
# partido, alineaciones y lesiones. Sin esta clave el importador sigue
# funcionando, pero solo con picks de equipo y de partido.
APIFOOTBALL_KEY=tu_clave_aqui


# =============================================================================
#  Cuentas de usuario y contador de la comunidad  ->  Supabase (plan gratuito)
#
#  1) Crea un proyecto en https://supabase.com  (tú, no yo: no doy de alta
#     cuentas ni escribo contraseñas en ningún sitio).
#  2) Settings -> API: copia la URL y la clave "anon public" aquí abajo.
#  3) SQL Editor: pega y ejecuta  supabase/esquema.sql  entero.
#  4) Authentication -> Providers:
#        · Google  -> pide un "OAuth client ID" en Google Cloud Console y
#                     pega el id y el secreto que te dé.
#        · Apple   -> necesita cuenta de Apple Developer de pago. Solo hace
#                     falta si publicas en la App Store.
#        · Email   -> viene activado; es el enlace mágico, sin contraseña.
#  5) Authentication -> URL Configuration: añade  scoutpicks://entrar  a las
#     "Redirect URLs", y también la dirección de tu web si la publicas.
#
#  Sin estas dos líneas la app arranca igual, sin pedir cuenta y guardando los
#  picks solo en el teléfono.
# =============================================================================
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
