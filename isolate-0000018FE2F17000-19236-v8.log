script-source,94,node:internal/abort_controller,'use strict';\x0d\n\x0d\n// Modeled very closely on the AbortController implementation\x0d\n// in https://github.com/mysticatea/abort-controller (MIT license)\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypePush\x2C\x0d\n  ObjectAssign\x2C\x0d\n  ObjectDefineProperties\x2C\x0d\n  ObjectDefineProperty\x2C\x0d\n  ObjectSetPrototypeOf\x2C\x0d\n  PromiseResolve\x2C\x0d\n  PromiseWithResolvers\x2C\x0d\n  SafeFinalizationRegistry\x2C\x0d\n  SafeSet\x2C\x0d\n  SafeWeakRef\x2C\x0d\n  Symbol\x2C\x0d\n  SymbolToStringTag\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  defineEventHandler\x2C\x0d\n  EventTarget\x2C\x0d\n  Event\x2C\x0d\n  kTrustEvent\x2C\x0d\n  kNewListener\x2C\x0d\n  kRemoveListener\x2C\x0d\n  kResistStopPropagation\x2C\x0d\n  kWeakHandler\x2C\x0d\n} = require('internal/event_target');\x0d\nconst { kMaxEventTargetListeners } = require('events');\x0d\nconst {\x0d\n  customInspectSymbol\x2C\x0d\n  kEmptyObject\x2C\x0d\n  kEnumerableProperty\x2C\x0d\n} = require('internal/util');\x0d\nconst { inspect } = require('internal/util/inspect');\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_ILLEGAL_CONSTRUCTOR\x2C\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_THIS\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\nconst {\x0d\n  converters\x2C\x0d\n  createInterfaceConverter\x2C\x0d\n  createSequenceConverter\x2C\x0d\n} = require('internal/webidl');\x0d\n\x0d\nconst {\x0d\n  validateObject\x2C\x0d\n  validateUint32\x2C\x0d\n  kValidateObjectAllowObjects\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst {\x0d\n  DOMException\x2C\x0d\n} = internalBinding('messaging');\x0d\n\x0d\nconst {\x0d\n  clearTimeout\x2C\x0d\n  setTimeout\x2C\x0d\n} = require('timers');\x0d\nconst assert = require('internal/assert');\x0d\n\x0d\nconst {\x0d\n  kDeserialize\x2C\x0d\n  kTransfer\x2C\x0d\n  kTransferList\x2C\x0d\n  markTransferMode\x2C\x0d\n} = require('internal/worker/js_transferable');\x0d\n\x0d\nlet _MessageChannel;\x0d\n\x0d\nconst kDontThrowSymbol = Symbol('kDontThrowSymbol');\x0d\n\x0d\n// Loading the MessageChannel and markTransferable have to be done lazily\x0d\n// because otherwise we'll end up with a require cycle that ends up with\x0d\n// an incomplete initialization of abort_controller.\x0d\n\x0d\nfunction lazyMessageChannel() {\x0d\n  _MessageChannel ??= require('internal/worker/io').MessageChannel;\x0d\n  return new _MessageChannel();\x0d\n}\x0d\n\x0d\nconst clearTimeoutRegistry = new SafeFinalizationRegistry(clearTimeout);\x0d\nconst dependantSignalsCleanupRegistry = new SafeFinalizationRegistry(\x0d\n  ({ sourceSignalRef\x2C dependantSignalRef\x2C sourceSignalsCleanupToken }) => {\x0d\n    sourceSignalsCleanupRegistry.unregister(sourceSignalsCleanupToken);\x0d\n\x0d\n    const sourceSignal = sourceSignalRef.deref();\x0d\n    if (sourceSignal === undefined) {\x0d\n      return;\x0d\n    }\x0d\n    sourceSignal[kDependantSignals].delete(dependantSignalRef);\x0d\n  });\x0d\n\x0d\nconst gcPersistentSignals = new SafeSet();\x0d\n\x0d\nconst sourceSignalsCleanupRegistry = new SafeFinalizationRegistry(({ sourceSignalRef\x2C composedSignalRef }) => {\x0d\n  const composedSignal = composedSignalRef.deref();\x0d\n  if (composedSignal !== undefined) {\x0d\n    composedSignal[kSourceSignals].delete(sourceSignalRef);\x0d\n\x0d\n    if (composedSignal[kSourceSignals].size === 0) {\x0d\n      // This signal will no longer abort. There's no need to keep it in the gcPersistentSignals set.\x0d\n      gcPersistentSignals.delete(composedSignal);\x0d\n    }\x0d\n  }\x0d\n});\x0d\n\x0d\nconst kAborted = Symbol('kAborted');\x0d\nconst kReason = Symbol('kReason');\x0d\nconst kCloneData = Symbol('kCloneData');\x0d\nconst kTimeout = Symbol('kTimeout');\x0d\nconst kMakeTransferable = Symbol('kMakeTransferable');\x0d\nconst kComposite = Symbol('kComposite');\x0d\nconst kFollowing = Symbol('kFollowing');\x0d\nconst kResultSignalWeakRef = Symbol('kResultSignalWeakRef');\x0d\nconst kSourceSignals = Symbol('kSourceSignals');\x0d\nconst kDependantSignals = Symbol('kDependantSignals');\x0d\n\x0d\nfunction customInspect(self\x2C obj\x2C depth\x2C options) {\x0d\n  if (depth < 0)\x0d\n    return self;\x0d\n\x0d\n  const opts = ObjectAssign({}\x2C options\x2C {\x0d\n    depth: options.depth === null ? null : options.depth - 1\x2C\x0d\n  });\x0d\n\x0d\n  return `${self.constructor.name} ${inspect(obj\x2C opts)}`;\x0d\n}\x0d\n\x0d\nfunction validateThisAbortSignal(obj) {\x0d\n  if (obj?.[kAborted] === undefined)\x0d\n    throw new ERR_INVALID_THIS('AbortSignal');\x0d\n}\x0d\n\x0d\nfunction refreshCompositeSignal(signal) {\x0d\n  if (!signal[kComposite] || signal[kAborted] || !signal[kSourceSignals]?.size) {\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  for (const sourceSignalWeakRef of signal[kSourceSignals]) {\x0d\n    const sourceSignal = sourceSignalWeakRef.deref();\x0d\n    if (sourceSignal === undefined) {\x0d\n      signal[kSourceSignals].delete(sourceSignalWeakRef);\x0d\n      continue;\x0d\n    }\x0d\n\x0d\n    if (sourceSignal.aborted) {\x0d\n      abortSignal(signal\x2C sourceSignal.reason);\x0d\n      return;\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction followCompositeSignal(signal) {\x0d\n  if (signal[kFollowing] || signal[kAborted] || !signal[kSourceSignals]?.size) {\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  const resultSignalWeakRef = signal[kResultSignalWeakRef] ??= new SafeWeakRef(signal);\x0d\n\x0d\n  for (const sourceSignalWeakRef of signal[kSourceSignals]) {\x0d\n    const sourceSignal = sourceSignalWeakRef.deref();\x0d\n    if (sourceSignal === undefined) {\x0d\n      signal[kSourceSignals].delete(sourceSignalWeakRef);\x0d\n      continue;\x0d\n    }\x0d\n\x0d\n    if (sourceSignal.aborted) {\x0d\n      abortSignal(signal\x2C sourceSignal.reason);\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    sourceSignal[kDependantSignals] ??= new SafeSet();\x0d\n    sourceSignal[kDependantSignals].add(resultSignalWeakRef);\x0d\n    dependantSignalsCleanupRegistry.register(signal\x2C {\x0d\n      sourceSignalRef: sourceSignalWeakRef\x2C\x0d\n      dependantSignalRef: resultSignalWeakRef\x2C\x0d\n      sourceSignalsCleanupToken: sourceSignalWeakRef\x2C\x0d\n    });\x0d\n    sourceSignalsCleanupRegistry.register(sourceSignal\x2C {\x0d\n      sourceSignalRef: sourceSignalWeakRef\x2C\x0d\n      composedSignalRef: resultSignalWeakRef\x2C\x0d\n    }\x2C sourceSignalWeakRef);\x0d\n  }\x0d\n\x0d\n  signal[kFollowing] = true;\x0d\n}\x0d\n\x0d\n// Because the AbortSignal timeout cannot be canceled\x2C we don't want the\x0d\n// presence of the timer alone to keep the AbortSignal from being garbage\x0d\n// collected if it otherwise no longer accessible. We also don't want the\x0d\n// timer to keep the Node.js process open on it's own. Therefore\x2C we wrap\x0d\n// the AbortSignal in a WeakRef and have the setTimeout callback close\x0d\n// over the WeakRef rather than directly over the AbortSignal\x2C and we unref\x0d\n// the created timer object. Separately\x2C we add the signal to a\x0d\n// FinalizerRegistry that will clear the timeout when the signal is gc'd.\x0d\nfunction setWeakAbortSignalTimeout(weakRef\x2C delay) {\x0d\n  const timeout = setTimeout(() => {\x0d\n    const signal = weakRef.deref();\x0d\n    if (signal !== undefined) {\x0d\n      clearTimeoutRegistry.unregister(signal);\x0d\n      gcPersistentSignals.delete(signal);\x0d\n      abortSignal(\x0d\n        signal\x2C\x0d\n        new DOMException(\x0d\n          'The operation was aborted due to timeout'\x2C\x0d\n          'TimeoutError'));\x0d\n    }\x0d\n  }\x2C delay);\x0d\n  timeout.unref();\x0d\n  return timeout;\x0d\n}\x0d\n\x0d\nclass AbortSignal extends EventTarget {\x0d\n\x0d\n  /**\x0d\n   * @param {symbol | undefined} dontThrowSymbol\x0d\n   * @param {{\x0d\n   *   aborted? : boolean\x2C\x0d\n   *   reason? : any\x2C\x0d\n   *   transferable? : boolean\x2C\x0d\n   *   composite? : boolean\x2C\x0d\n   * }} [init]\x0d\n   * @private\x0d\n   */\x0d\n  constructor(dontThrowSymbol = undefined\x2C init = kEmptyObject) {\x0d\n    if (dontThrowSymbol !== kDontThrowSymbol) {\x0d\n      throw new ERR_ILLEGAL_CONSTRUCTOR();\x0d\n    }\x0d\n    super();\x0d\n\x0d\n    this[kMaxEventTargetListeners] = 0;\x0d\n    const {\x0d\n      aborted = false\x2C\x0d\n      reason = undefined\x2C\x0d\n      transferable = false\x2C\x0d\n      composite = false\x2C\x0d\n    } = init;\x0d\n    this[kAborted] = aborted;\x0d\n    this[kReason] = reason;\x0d\n    this[kComposite] = composite;\x0d\n    if (transferable) {\x0d\n      markTransferMode(this\x2C false\x2C true);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @type {boolean}\x0d\n   */\x0d\n  get aborted() {\x0d\n    validateThisAbortSignal(this);\x0d\n    refreshCompositeSignal(this);\x0d\n    return !!this[kAborted];\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @type {any}\x0d\n   */\x0d\n  get reason() {\x0d\n    validateThisAbortSignal(this);\x0d\n    refreshCompositeSignal(this);\x0d\n    return this[kReason];\x0d\n  }\x0d\n\x0d\n  throwIfAborted() {\x0d\n    validateThisAbortSignal(this);\x0d\n    refreshCompositeSignal(this);\x0d\n    if (this[kAborted]) {\x0d\n      throw this[kReason];\x0d\n    }\x0d\n  }\x0d\n\x0d\n  [customInspectSymbol](depth\x2C options) {\x0d\n    return customInspect(this\x2C {\x0d\n      aborted: this.aborted\x2C\x0d\n    }\x2C depth\x2C options);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @param {any} [reason]\x0d\n   * @returns {AbortSignal}\x0d\n   */\x0d\n  static abort(\x0d\n    reason = new DOMException('This operation was aborted'\x2C 'AbortError')) {\x0d\n    return new AbortSignal(kDontThrowSymbol\x2C { aborted: true\x2C reason });\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @param {number} delay\x0d\n   * @returns {AbortSignal}\x0d\n   */\x0d\n  static timeout(delay) {\x0d\n    validateUint32(delay\x2C 'delay'\x2C false);\x0d\n    const signal = new AbortSignal(kDontThrowSymbol);\x0d\n    signal[kTimeout] = true;\x0d\n    clearTimeoutRegistry.register(\x0d\n      signal\x2C\x0d\n      setWeakAbortSignalTimeout(new SafeWeakRef(signal)\x2C delay)\x2C\x0d\n      signal);\x0d\n    return signal;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @param {AbortSignal[]} signals\x0d\n   * @returns {AbortSignal}\x0d\n   */\x0d\n  static any(signals) {\x0d\n    const signalsArray = converters['sequence<AbortSignal>'](\x0d\n      signals\x2C\x0d\n      { __proto__: null\x2C context: 'signals' }\x2C\x0d\n    );\x0d\n\x0d\n    const resultSignal = new AbortSignal(kDontThrowSymbol\x2C { composite: true });\x0d\n    if (!signalsArray.length) {\x0d\n      return resultSignal;\x0d\n    }\x0d\n\x0d\n    resultSignal[kSourceSignals] = new SafeSet();\x0d\n\x0d\n    // Track if we have any timeout signals\x0d\n    let hasTimeoutSignals = false;\x0d\n\x0d\n    for (let i = 0; i < signalsArray.length; i++) {\x0d\n      const signal = signalsArray[i];\x0d\n\x0d\n      // Check if this is a timeout signal\x0d\n      if (signal[kTimeout]) {\x0d\n        hasTimeoutSignals = true;\x0d\n\x0d\n        // Add the timeout signal to gcPersistentSignals to keep it alive\x0d\n        // This is what the kNewListener method would do when adding abort listeners\x0d\n        gcPersistentSignals.add(signal);\x0d\n      }\x0d\n\x0d\n      if (signal.aborted) {\x0d\n        abortSignal(resultSignal\x2C signal.reason);\x0d\n        return resultSignal;\x0d\n      }\x0d\n\x0d\n      if (!signal[kComposite]) {\x0d\n        const signalWeakRef = new SafeWeakRef(signal);\x0d\n        resultSignal[kSourceSignals].add(signalWeakRef);\x0d\n      } else if (!signal[kSourceSignals]) {\x0d\n        continue;\x0d\n      } else {\x0d\n        refreshCompositeSignal(signal);\x0d\n        if (signal.aborted) {\x0d\n          abortSignal(resultSignal\x2C signal.reason);\x0d\n          return resultSignal;\x0d\n        }\x0d\n        for (const sourceSignalWeakRef of signal[kSourceSignals]) {\x0d\n          const sourceSignal = sourceSignalWeakRef.deref();\x0d\n          if (!sourceSignal) {\x0d\n            continue;\x0d\n          }\x0d\n          assert(!sourceSignal[kComposite]);\x0d\n\x0d\n          if (sourceSignal.aborted) {\x0d\n            abortSignal(resultSignal\x2C sourceSignal.reason);\x0d\n            return resultSignal;\x0d\n          }\x0d\n\x0d\n          if (resultSignal[kSourceSignals].has(sourceSignalWeakRef)) {\x0d\n            continue;\x0d\n          }\x0d\n          resultSignal[kSourceSignals].add(sourceSignalWeakRef);\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n\x0d\n    if (hasTimeoutSignals && resultSignal[kSourceSignals].size > 0) {\x0d\n      resultSignal[kTimeout] = true;\x0d\n    }\x0d\n\x0d\n    return resultSignal;\x0d\n  }\x0d\n\x0d\n  [kNewListener](size\x2C type\x2C listener\x2C once\x2C capture\x2C passive\x2C weak) {\x0d\n    super[kNewListener](size\x2C type\x2C listener\x2C once\x2C capture\x2C passive\x2C weak);\x0d\n\x0d\n    if (this[kComposite] && type === 'abort' && !this.aborted && size === 1) {\x0d\n      followCompositeSignal(this);\x0d\n    }\x0d\n\x0d\n    const isTimeoutOrNonEmptyCompositeSignal = this[kTimeout] || (this[kComposite] && this[kSourceSignals]?.size);\x0d\n    if (isTimeoutOrNonEmptyCompositeSignal &&\x0d\n        type === 'abort' &&\x0d\n        !this.aborted &&\x0d\n        !weak &&\x0d\n        size === 1) {\x0d\n      // If this is a timeout signal\x2C or a non-empty composite signal\x2C and we're adding a non-weak abort\x0d\n      // listener\x2C then we don't want it to be gc'd while the listener\x0d\n      // is attached and the timer still hasn't fired. So\x2C we retain a\x0d\n      // strong ref that is held for as long as the listener is registered.\x0d\n      gcPersistentSignals.add(this);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  [kRemoveListener](size\x2C type\x2C listener\x2C capture) {\x0d\n    super[kRemoveListener](size\x2C type\x2C listener\x2C capture);\x0d\n    const isTimeoutOrNonEmptyCompositeSignal = this[kTimeout] || (this[kComposite] && this[kSourceSignals]?.size);\x0d\n    if (isTimeoutOrNonEmptyCompositeSignal && type === 'abort' && size === 0) {\x0d\n      gcPersistentSignals.delete(this);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  [kTransfer]() {\x0d\n    validateThisAbortSignal(this);\x0d\n    const aborted = this.aborted;\x0d\n    if (aborted) {\x0d\n      const reason = this.reason;\x0d\n      return {\x0d\n        data: { aborted\x2C reason }\x2C\x0d\n        deserializeInfo: 'internal/abort_controller:ClonedAbortSignal'\x2C\x0d\n      };\x0d\n    }\x0d\n\x0d\n    const { port1\x2C port2 } = this[kCloneData];\x0d\n    this[kCloneData] = undefined;\x0d\n\x0d\n    this.addEventListener('abort'\x2C () => {\x0d\n      port1.postMessage(this.reason);\x0d\n      port1.close();\x0d\n    }\x2C { once: true });\x0d\n\x0d\n    return {\x0d\n      data: { port: port2 }\x2C\x0d\n      deserializeInfo: 'internal/abort_controller:ClonedAbortSignal'\x2C\x0d\n    };\x0d\n  }\x0d\n\x0d\n  [kTransferList]() {\x0d\n    if (!this.aborted) {\x0d\n      const { port1\x2C port2 } = lazyMessageChannel();\x0d\n      port1.unref();\x0d\n      port2.unref();\x0d\n      this[kCloneData] = {\x0d\n        port1\x2C\x0d\n        port2\x2C\x0d\n      };\x0d\n      return [port2];\x0d\n    }\x0d\n    return [];\x0d\n  }\x0d\n\x0d\n  [kDeserialize]({ aborted\x2C reason\x2C port }) {\x0d\n    if (aborted) {\x0d\n      this[kAborted] = aborted;\x0d\n      this[kReason] = reason;\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    port.onmessage = ({ data }) => {\x0d\n      abortSignal(this\x2C data);\x0d\n      port.close();\x0d\n      port.onmessage = undefined;\x0d\n    };\x0d\n    // The receiving port\x2C by itself\x2C should never keep the event loop open.\x0d\n    // The unref() has to be called *after* setting the onmessage handler.\x0d\n    port.unref();\x0d\n  }\x0d\n}\x0d\n\x0d\nconverters.AbortSignal = createInterfaceConverter('AbortSignal'\x2C AbortSignal.prototype);\x0d\nconverters['sequence<AbortSignal>'] = createSequenceConverter(converters.AbortSignal);\x0d\n\x0d\nfunction ClonedAbortSignal() {\x0d\n  return new AbortSignal(kDontThrowSymbol\x2C { transferable: true });\x0d\n}\x0d\nClonedAbortSignal.prototype[kDeserialize] = () => {};\x0d\n\x0d\nObjectDefineProperties(AbortSignal.prototype\x2C {\x0d\n  aborted: kEnumerableProperty\x2C\x0d\n});\x0d\n\x0d\nObjectDefineProperty(AbortSignal.prototype\x2C SymbolToStringTag\x2C {\x0d\n  __proto__: null\x2C\x0d\n  writable: false\x2C\x0d\n  enumerable: false\x2C\x0d\n  configurable: true\x2C\x0d\n  value: 'AbortSignal'\x2C\x0d\n});\x0d\n\x0d\ndefineEventHandler(AbortSignal.prototype\x2C 'abort');\x0d\n\x0d\n// https://dom.spec.whatwg.org/#dom-abortsignal-abort\x0d\nfunction abortSignal(signal\x2C reason) {\x0d\n  // 1. If signal is aborted\x2C then return.\x0d\n  if (signal[kAborted]) return;\x0d\n\x0d\n  // 2. Set signal's abort reason to reason if it is given;\x0d\n  //    otherwise to a new "AbortError" DOMException.\x0d\n  signal[kAborted] = true;\x0d\n  signal[kReason] = reason;\x0d\n\x0d\n  // 3. Let dependentSignalsToAbort be a new list.\x0d\n  const dependentSignalsToAbort = ObjectSetPrototypeOf([]\x2C null);\x0d\n\x0d\n  // 4. For each dependentSignal of signal's dependent signals:\x0d\n  signal[kDependantSignals]?.forEach((s) => {\x0d\n    const dependentSignal = s.deref();\x0d\n    // 1. If dependentSignal is not aborted\x2C then:\x0d\n    if (dependentSignal && !dependentSignal[kAborted]) {\x0d\n      // 1. Set dependentSignal's abort reason to signal's abort reason.\x0d\n      dependentSignal[kReason] = reason;\x0d\n      dependentSignal[kAborted] = true;\x0d\n      // 2. Append dependentSignal to dependentSignalsToAbort.\x0d\n      ArrayPrototypePush(dependentSignalsToAbort\x2C dependentSignal);\x0d\n    }\x0d\n  });\x0d\n\x0d\n  // 5. Run the abort steps for signal\x0d\n  runAbort(signal);\x0d\n\x0d\n  // 6. For each dependentSignal of dependentSignalsToAbort\x2C\x0d\n  //    run the abort steps for dependentSignal.\x0d\n  for (let i = 0; i < dependentSignalsToAbort.length; i++) {\x0d\n    const dependentSignal = dependentSignalsToAbort[i];\x0d\n    runAbort(dependentSignal);\x0d\n    // A transitively-aborted dependent signal can never abort again\x2C so there\x0d\n    // is no longer any reason to keep it alive. Dropping it from\x0d\n    // gcPersistentSignals lets it be collected\x2C which in turn prunes its\x0d\n    // WeakRef from its sources' kDependantSignals sets. Otherwise\x2C an observed\x0d\n    // composite that follows a long-lived source stays retained forever and\x0d\n    // its entry accumulates in that source's kDependantSignals.\x0d\n    gcPersistentSignals.delete(dependentSignal);\x0d\n  }\x0d\n\x0d\n  // Clean up the signal from gcPersistentSignals\x0d\n  gcPersistentSignals.delete(signal);\x0d\n\x0d\n  // If this is a composite signal\x2C also remove all of its source signals from gcPersistentSignals\x0d\n  // when they get dereferenced from the signal's kSourceSignals set\x0d\n  if (signal[kComposite] && signal[kSourceSignals]) {\x0d\n    signal[kSourceSignals].forEach((sourceWeakRef) => {\x0d\n      const sourceSignal = sourceWeakRef.deref();\x0d\n      if (sourceSignal) {\x0d\n        gcPersistentSignals.delete(sourceSignal);\x0d\n      }\x0d\n    });\x0d\n  }\x0d\n}\x0d\n\x0d\n// To run the abort steps for an AbortSignal signal\x0d\nfunction runAbort(signal) {\x0d\n  const event = new Event('abort'\x2C {\x0d\n    [kTrustEvent]: true\x2C\x0d\n  });\x0d\n  signal.dispatchEvent(event);\x0d\n}\x0d\n\x0d\nclass AbortController {\x0d\n  #signal;\x0d\n\x0d\n  /**\x0d\n   * @type {AbortSignal}\x0d\n   */\x0d\n  get signal() {\x0d\n    this.#signal ??= new AbortSignal(kDontThrowSymbol);\x0d\n\x0d\n    return this.#signal;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @param {any} [reason]\x0d\n   */\x0d\n  abort(reason = new DOMException('This operation was aborted'\x2C 'AbortError')) {\x0d\n    abortSignal(this.#signal ??= new AbortSignal(kDontThrowSymbol)\x2C reason);\x0d\n  }\x0d\n\x0d\n  [customInspectSymbol](depth\x2C options) {\x