    value: RegExpPrototypeGetMultiline(pattern)\x2C\x0d\n    }\x2C\x0d\n    source: {\x0d\n      __proto__: null\x2C\x0d\n      configurable: true\x2C\x0d\n      value: RegExpPrototypeGetSource(pattern)\x2C\x0d\n    }\x2C\x0d\n    sticky: {\x0d\n      __proto__: null\x2C\x0d\n      configurable: true\x2C\x0d\n      value: RegExpPrototypeGetSticky(pattern)\x2C\x0d\n    }\x2C\x0d\n    unicode: {\x0d\n      __proto__: null\x2C\x0d\n      configurable: true\x2C\x0d\n      value: RegExpPrototypeGetUnicode(pattern)\x2C\x0d\n    }\x2C\x0d\n  });\x0d\n  ObjectDefineProperty(pattern\x2C 'flags'\x2C {\x0d\n    __proto__: null\x2C\x0d\n    configurable: true\x2C\x0d\n    value: RegExpPrototypeGetFlags(pattern)\x2C\x0d\n  });\x0d\n  return pattern;\x0d\n};\x0d\n\x0d\n\x0d\n/**\x0d\n * @param {string} str\x0d\n * @param {RegExp} regexp\x0d\n * @returns {number}\x0d\n */\x0d\nprimordials.SafeStringPrototypeSearch = (str\x2C regexp) => {\x0d\n  regexp.lastIndex = 0;\x0d\n  const match = RegExpPrototypeExec(regexp\x2C str);\x0d\n  return match ? match.index : -1;\x0d\n};\x0d\n\x0d\n/**\x0d\n * Variadic functions with lots of arguments will cause stack overflow errors.\x0d\n * Use this function when `items` can be arbitrarily large\x2C this function splits\x0d\n * it into chunks of size 2**16 making stack overflow less likely.\x0d\n * @param {Array<unknown>} arr\x0d\n * @param {Parameters<typeof Array.prototype.push>} items\x0d\n * @returns {ReturnType<typeof Array.prototype.push>}\x0d\n */\x0d\nprimordials.SafeArrayPrototypePushApply = (arr\x2C items) => {\x0d\n  let end = 0x10000;\x0d\n  if (end < items.length) {\x0d\n    let start = 0;\x0d\n    do {\x0d\n      ArrayPrototypePushApply(arr\x2C ArrayPrototypeSlice(items\x2C start\x2C start = end));\x0d\n      end += 0x10000;\x0d\n    } while (end < items.length);\x0d\n    items = ArrayPrototypeSlice(items\x2C start);\x0d\n  }\x0d\n  return ArrayPrototypePushApply(arr\x2C items);\x0d\n};\x0d\n\x0d\nObjectSetPrototypeOf(primordials\x2