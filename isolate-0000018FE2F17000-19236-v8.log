.id;\n    const margenes = suyos.map(\n      ({ p\x2C esLocal }) => esLocal ? p.golesLocal - p.golesVisitante : p.golesVisitante - p.golesLocal\n    );\n    const fuerzaHoyH = fuerzaDe(rival.id) ?? rival.fuerza ?? null;\n    const pesosH = suyos.map(({ p\x2C esLocal }) => {\n      const rivalId = esLocal ? p.visitanteId : p.localId;\n      const peso = pesoPorRival(fuerzaDe(rivalId)\x2C fuerzaHoyH);\n      return rivalId === rival.id ? peso * PESO_ENFRENTAMIENTO : peso;\n    });\n    const fuerzaPropia = fuerzaDe(equipo.id) ?? equipo.fuerza ?? 70;\n    const fuerzaRival = fuerzaDe(rival.id) ?? rival.fuerza ?? 70;\n    const margenEsperado = (fuerzaPropia - fuerzaRival) / 11 + (enCasa ? 0.32 : -0.32);\n    for (const h of HANDICAPS) {\n      const ev = evalua(margenes\x2C -h\x2C "mas");\n      if (ev.aciertosL10 < 7) continue;\n      const lineaCubrir = -h;\n      const id = `${partidoId}-${equipo.id}-handicap-${lineaCubrir < 0 ? `m${Math.abs(lineaCubrir)}` : lineaCubrir}-mas`;\n      const base = probabilidad(ev.aciertosL10\x2C ev.aciertosL20\x2C ev.muestraL20\x2C ev.aciertosL40\x2C ev.muestraL40);\n      const enContexto = tasaEnContexto(margenes\x2C pesosH\x2C -h\x2C "mas");\n      const parecidoMedio = pesosH.length ? pesosH.reduce((a\x2C b) => a + Math.min(b\x2C 1)\x2C 0) / pesosH.length : 1;\n      const pesoContexto = 0.5 + (1 - Math.min(1\x2C parecidoMedio)) * 0.35;\n      let prob = enContexto === null ? base : base * (1 - pesoContexto) + enContexto * pesoContexto;\n      prob = Math.min(0.94\x2C Math.max(0.06\x2C prob));\n      const pMercado = normalSobre(margenEsperado\x2C 1.6\x2C -h);\n      const cuota = precioDe(pMercado\x2C casaId\x2C id);\n      const ventaja = Number(((prob - 1 / cuota) * 100).toFixed(1));\n      if (!admisible(cuota\x2C ventaja\x2C "mas")) continue;\n      const signo = h > 0 ? `+${linea(h)}` : linea(h);\n      const explica = h > 0 ? `le valen ${h === 0.5 ? "la victoria y el empate" : `la victoria\x2C el empate y perder por ${Math.floor(h)}`}` : `tiene que ganar por ${Math.ceil(-h)} o m\\xE1s`;\n      picks.push({\n        id\x2C\n        partidoId\x2C\n        competicionId: compReal\x2C\n        sujeto: "equipo"\x2C\n        sujetoId: equipo.id\x2C\n        titulo: equipo.nombre\x2C\n        contexto\x2C\n        argumento: `Con h\\xE1ndicap ${signo} a ${equipo.nombre} ${explica}. Lo habr\\xEDa cubierto en ${ev.aciertosL10} de sus \\xFAltimos 10 partidos (diferencia media de ${coma(ev.media)} goles).`\x2C\n        familia: "resultado"\x2C\n        mercado: `H\\xE1ndicap ${signo}`\x2C\n        metrica: "handicap"\x2C\n        // La l\xednea que se compara\x2C no el h\xe1ndicap: el r\xf3tulo ya dice "+0.5".\n        linea: lineaCubrir\x2C\n        // El sentido real es "cubrir": se marca como `mas` porque as\xed se\n        // compara con la l\xednea\x2C pero NO es un "m\xe1s de" de los que el directo\n        // puede dar por cumplidos a media parte \u2014un h\xe1ndicap no se cierra hasta\n        // el pitido final\u2014\x2C y por eso la m\xe9trica no est\xe1 entre las que mira.\n        sentido: "mas"\x2C\n        cuota\x2C\n        casa: casaId\x2C\n        precioReal: false\x2C\n        recomendado: recomendable("resultado"\x2C ev.aciertosL10)\x2C\n        racha: ev.racha\x2C\n        aciertosL5: ev.aciertosL5\x2C\n        aciertosL10: ev.aciertosL10\x2C\n        aciertosL20: ev.aciertosL20\x2C\n        muestraL20: ev.muestraL20\x2C\n        media: ev.media\x2C\n        probabilidad: prob\x2C\n        ventaja\x2C\n        imagen: equipo.bandera\x2C\n        esBandera: true\x2C\n        nombres: [equipo.nombre]\n      });\n    }\n  }\n  const vistosPartido = /* @__PURE__ */ new Set();\n  const delPartido = [...historialDe(local)\x2C ...historialDe(visitante)].map(({ p }) => p).filter((p) => vistosPartido.has(p.id) ? false : (vistosPartido.add(p.id)\x2C true)).sort((a\x2C b) => b.fecha.localeCompare(a.fecha));\n  if (delPartido.length >= 8) {\n    for (const met of METRICAS_PARTIDO) {\n  