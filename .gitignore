.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# datos importados y cache del importador
.env
.cache-datos/

# Registro del importador: se regenera en cada pasada.
scripts/refrescar.log

# Los datos de las competiciones viven en Supabase, no en el repositorio:
# pesan 70 MB y cambian cada día. La app se los descarga al arrancar y el
# robot los sube. Aqui solo queda la semilla vacia, para que compile.
src/datos/importado.json
# La versión comprimida que se sube a Supabase Storage: artefacto, no fuente.
src/datos/importado.json.gz

# Temporales de la CLI de Supabase.
supabase/.temp/
