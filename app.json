{
  "expo": {
    "name": "Golden Picks",
    "slug": "scout-picks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/imagenes/icono.png",
    "scheme": "scoutpicks",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B0D",
    "primaryColor": "#C9FF3D",
    "locales": {},
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scoutpicks.app",
      "infoPlist": {
        "CFBundleDisplayName": "Golden Picks",
        "UIUserInterfaceStyle": "Dark"
      }
    },
    "android": {
      "package": "com.scoutpicks.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0D",
        "foregroundImage": "./assets/imagenes/icono-adaptativo.png",
        "monochromeImage": "./assets/imagenes/icono-monocromo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/imagenes/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B0D",
          "image": "./assets/imagenes/splash.png",
          "imageWidth": 140
        }
      ],
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
